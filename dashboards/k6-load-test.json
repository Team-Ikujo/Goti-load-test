{
  "__inputs": [
    {
      "name": "DS_MIMIR",
      "label": "Mimir",
      "description": "K6 Prometheus Remote Write 메트릭 소스",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Goti K6 Load Test Dashboard — K6 기본 메트릭 + Goti 커스텀 메트릭",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "title": "HTTP Req Duration (p95)",
      "type": "stat",
      "targets": [
        {
          "expr": "k6_http_req_duration_p95{quantile=\"0.95\"}",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "title": "HTTP Failure Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(k6_http_reqs_total{expected_response=\"false\"}[1m]) / rate(k6_http_reqs_total[1m])",
          "legendFormat": "failure rate"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "title": "Active VUs",
      "type": "stat",
      "targets": [
        {
          "expr": "k6_vus",
          "legendFormat": "VUs"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "title": "Requests/sec",
      "type": "stat",
      "targets": [
        {
          "expr": "rate(k6_http_reqs_total[1m])",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 10,
      "title": "HTTP Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 11,
      "title": "HTTP Request Duration",
      "type": "timeseries",
      "targets": [
        {
          "expr": "k6_http_req_duration_p95{quantile=\"0.5\"}",
          "legendFormat": "p50"
        },
        {
          "expr": "k6_http_req_duration_p95{quantile=\"0.9\"}",
          "legendFormat": "p90"
        },
        {
          "expr": "k6_http_req_duration_p95{quantile=\"0.95\"}",
          "legendFormat": "p95"
        },
        {
          "expr": "k6_http_req_duration_p95{quantile=\"0.99\"}",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 12,
      "title": "Request Rate (by status)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(k6_http_reqs_total{expected_response=\"true\"}[1m]))",
          "legendFormat": "success"
        },
        {
          "expr": "sum(rate(k6_http_reqs_total{expected_response=\"false\"}[1m]))",
          "legendFormat": "failure"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "id": 13,
      "title": "VUs Over Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "k6_vus",
          "legendFormat": "active VUs"
        },
        {
          "expr": "k6_vus_max",
          "legendFormat": "max VUs"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 20,
      "title": "Goti Custom Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 21,
      "title": "Seat Selection Duration (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "k6_goti_seat_selection_duration_p95{quantile=\"0.5\"}",
          "legendFormat": "p50"
        },
        {
          "expr": "k6_goti_seat_selection_duration_p95{quantile=\"0.95\"}",
          "legendFormat": "p95"
        },
        {
          "expr": "k6_goti_seat_selection_duration_p95{quantile=\"0.99\"}",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 22,
      "title": "Order Duration (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "k6_goti_order_duration_p95{quantile=\"0.5\"}",
          "legendFormat": "p50"
        },
        {
          "expr": "k6_goti_order_duration_p95{quantile=\"0.95\"}",
          "legendFormat": "p95"
        },
        {
          "expr": "k6_goti_order_duration_p95{quantile=\"0.99\"}",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.2 },
              { "color": "green", "value": 0.3 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "id": 23,
      "title": "Ticket Success Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "k6_goti_ticket_success_rate",
          "legendFormat": "success rate"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_MIMIR}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "id": 24,
      "title": "Seat Conflicts (Cumulative)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "k6_goti_seat_conflicts",
          "legendFormat": "conflicts"
        },
        {
          "expr": "rate(k6_goti_seat_conflicts[1m])",
          "legendFormat": "conflicts/sec"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["k6", "load-test", "goti"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Goti - K6 Load Test",
  "uid": "goti-k6-load-test",
  "version": 1
}
