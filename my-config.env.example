# =============================================================================
# 부하테스트 개인 설정 (템플릿)
#
# 사용법:
#   1. 이 파일을 복사: cp my-config.env.example my-config.env
#   2. my-config.env에서 RUNNER_ID, RUNNER_NAME 수정
#   3. 타겟 경기 정보(GAME_ID/STADIUM_ID/HOME_TEAM_ID) 입력
#   4. 터미널 1: ./run.sh port-forward       (Mimir 메트릭 Push용)
#   5. 터미널 2: ./run.sh <시나리오>          (부하테스트 실행)
#
# 시나리오 목록:
#   smoke / e2e / spike / normal / soak
#   queue-suyeon / queue-suyeon-spike / queue-suyeon-saturation
#   queue-suyeon-heartbeat / queue-oneshot
#   (자세한 설명은 ./run.sh 인자 없이 실행)
# =============================================================================

# 내 러너 번호 (0~3) — 팀원마다 다른 번호 사용
#   0: kimhj, 1: suyeon, 2: junsang, 3: sungjeon
RUNNER_ID=0

# 내 이름 (대시보드에서 표시됨)
RUNNER_NAME=your-name

# -----------------------------------------------------------------------------
# 타겟 경기 정보
#   GAME_ID 비워두면 BASE_URL에서 AVAILABLE 경기 자동 선택
#   STADIUM_ID/HOME_TEAM_ID는 좌석 조회/예매 시나리오에서 필요
#   KBO 팀/구장 ID 참고: goti-team-controller memory `reference_team_stadium_ids.md`
# -----------------------------------------------------------------------------
GAME_ID=
STADIUM_ID=
HOME_TEAM_ID=

# 동시 사용자 수
VUS=20

# -----------------------------------------------------------------------------
# 타겟 환경
#   prod API: https://api.go-ti.shop  (도메인 분리 후 — 2026-04 기준)
#   prod 프론트: https://go-ti.shop
#   dev (SSH 터널): http://localhost:31080  (HOST_HEADER 필요)
#
#   ALB 직접 호출 (Cloudflare/CDN 우회, ALB 한계 측정용):
#     BASE_URL=https://goti-prod-alb-xxx.ap-northeast-2.elb.amazonaws.com
#     HOST_HEADER=api.go-ti.shop
#     → TLS 검증 skip 필요. flow-debug 시나리오는 자동 적용.
#       다른 시나리오는 k6 CLI에 --insecure-skip-tls-verify 추가
# -----------------------------------------------------------------------------
BASE_URL=https://api.go-ti.shop

# Queue 서비스 URL (비워두면 BASE_URL 사용)
QUEUE_URL=

# Host 헤더 오버라이드 (dev SSH 터널 사용 시 dev.go-ti.shop 등 지정)
HOST_HEADER=

# -----------------------------------------------------------------------------
# Mimir로 메트릭 Push — Grafana K6 대시보드에서 실시간 확인
# 사용하려면 별도 터미널에서 ./run.sh port-forward 먼저 실행
# -----------------------------------------------------------------------------
PUSH_METRICS=true
MIMIR_PUSH_URL=http://localhost:9009/api/v1/push

# 동시 시작 시각 (팀원 전원 같은 시각 입력하면 동시 시작)
# 비워두면 즉시 시작. 예: 09:30:00
START_TIME=

# 스파이크 최대 RPS
MAX_RATE=800

# Soak 지속 시간
DURATION=1h

# 테스트 세션명 (팀 전체 동일하게 설정하면 대시보드에서 한 세션으로 묶임)
# 비워두면 자동 생성: {scenario}-{timestamp}
TEST_NAME=
