# =============================================================================
# 부하테스트 개인 설정 (템플릿)
#
# 사용법:
#   1. 이 파일을 복사: cp my-config.env.example my-config.env
#   2. my-config.env에서 RUNNER_ID, RUNNER_NAME만 수정
#   3. 실행: ./run.sh e2e
# =============================================================================

# 내 러너 번호 (0~3) — 팀원마다 다른 번호 사용
RUNNER_ID=0

# 내 이름 (대시보드에서 표시됨)
RUNNER_NAME=your-name

# 타겟 경기 ID (비워두면 AVAILABLE 경기 자동 선택)
GAME_ID=

# 동시 사용자 수
VUS=20

# API URL
BASE_URL=

# Mimir로 메트릭 Push (true/false)
PUSH_METRICS=false

# Mimir URL (외부 접근 — port-forward 불필요)
MIMIR_PUSH_URL=

# 동시 시작 시각 (비워두면 즉시 시작, 예: 18:00:00)
START_TIME=

# 스파이크 최대 RPS
MAX_RATE=200

# Soak 지속 시간
DURATION=1h

# 테스트 세션명 (팀 전체 동일하게 설정하면 대시보드에서 한 세션으로 묶임)
# 비워두면 자동 생성: {scenario}-{timestamp}
TEST_NAME=
